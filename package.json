    "next": "^16.3.6",
    "openai": "^7.23.0",
    "playwright": "^1.63.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/playwright": "^1.3.6",
    "@cloudflare/vite-plugin": "^1.60.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "postcss": "^8",
    "react-server-dom-webpack": "^19.3.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vinext": "^1.0.0-beta.12",
    "vite": "^8.3.1",
    "wrangler": "^4.141.0"
